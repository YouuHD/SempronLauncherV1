<Window x:Class="Launcher_v1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher_v1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Lanzar juego" HorizontalAlignment="Left" Margin="38,97,0,0" VerticalAlignment="Top" Click="Button_Click" x:Name="btnLaunch"/>
        <Label Content="Pon el id de steam" HorizontalAlignment="Left" Margin="38,45,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="176,53,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Cursor="" x:Name="txtGame" />
        <Label Content="id de juego" HorizontalAlignment="Left" Margin="38,168,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.147,-0.221" ContentStringFormat="" x:Name="vis"/>
        <Button Content="Escanear librería" HorizontalAlignment="Left" Margin="150,97,0,0" VerticalAlignment="Top" Click="Button_Click_1" x:Name="btnPrueba"/>
        <ComboBox HorizontalAlignment="Left" Margin="400,53,0,0" VerticalAlignment="Top" Width="120" x:Name="Lista" DisplayMemberPath="Name" SelectedValuePath="AppId"/>

    </Grid>
</Window>
